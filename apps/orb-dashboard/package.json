{
  "name": "orb-dashboard",
  "version": "0.1.0",
  "description": "The Orb - Central Information Repository",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "electron:dev": "concurrently \"npm run build\" \"npm start\"",
    "electron:build": "tsc && vite build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "lucide-react": "^1.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "date-fns": "^4.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^1.1.2",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^8.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "type": "module",
  "build": {
    "appId": "com.daniele.orb-dashboard",
    "productName": "The Orb",
    "directories": {
      "output": "dist/mac-arm64",
      "app": "."
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "src/assets/orb-icon.png"
    }
  }
}
