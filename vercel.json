{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/book-embodiment-somatic",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/book-presence-communication",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/services/ameb-accompanying",
      "destination": "/ameb-accompanying",
      "permanent": true
    },
    {
      "source": "/ceremony-specialist",
      "destination": "/live-piano-services",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/book-voice-piano",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/quote/:slug",
      "destination": "/quotes/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
